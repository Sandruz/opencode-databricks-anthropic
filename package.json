{
  "name": "opencode-databricks-anthropic",
  "version": "0.3.0",
  "description": "OpenCode plugin for Anthropic models behind Databricks AI Gateway",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "opencode": ">=1.3.13"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc",
    "pack:check": "node scripts/validate-package.mjs",
    "smoke:loader": "node scripts/smoke-loader.mjs",
    "check": "npm run test && npm run typecheck && npm run build && npm run pack:check && npm run smoke:loader",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "opencode",
    "databricks",
    "anthropic",
    "ai-gateway"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sandruz/opencode-databricks-anthropic.git"
  },
  "bugs": {
    "url": "https://github.com/Sandruz/opencode-databricks-anthropic/issues"
  },
  "homepage": "https://github.com/Sandruz/opencode-databricks-anthropic#readme",
  "dependencies": {
    "@opencode-ai/plugin": "1.14.19"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "opencode-ai": "1.3.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
